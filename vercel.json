{
  "version": 2,
  "name": "cooksmart",
  "builds": [
    {
      "src": "server/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "landing-page/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "server/src/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "server/src/index.js"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/landing-page/$1"
    },
    {
      "source": "/",
      "destination": "/landing-page/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
