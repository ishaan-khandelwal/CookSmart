{
  "version": 2,
  "name": "cooksmart",
  "builds": [
    {
      "src": "server/src/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "landing-page/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "server/src/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "server/src/index.js"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api|uploads|app|_expo|assets/node_modules|assets/assets).*)",
      "destination": "/landing-page/$1"
    },
    {
      "source": "/",
      "destination": "/landing-page/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
